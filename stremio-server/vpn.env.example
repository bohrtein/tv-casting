# Settings for the VPN container (tv-casting-vpn.service). Copy this to
# /etc/tv-casting/vpn.env on the server, fill in your PIA login, and make
# it readable by root only:
#   sudo mkdir -p /etc/tv-casting
#   sudo cp stremio-server/vpn.env.example /etc/tv-casting/vpn.env
#   sudo nano /etc/tv-casting/vpn.env
#   sudo chmod 600 /etc/tv-casting/vpn.env
# Never commit the filled-in copy.
#
# Docker reads this file literally: no quotes around values, and no
# spaces around "=" (the space in "private internet access" is part of
# the value and is fine).

VPN_SERVICE_PROVIDER=private internet access

# Your PIA username (looks like p1234567) and password.
OPENVPN_USER=p1234567
OPENVPN_PASSWORD=change-me

# A PIA region near you: closer means faster. List the exact names with:
#   sudo docker run --rm qmcgaw/gluetun format-servers -private-internet-access
SERVER_REGIONS=Netherlands
