# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*

# Env / secrets
.env
.env.*
!.env.example

# OS cruft
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Tizen Studio build output
tv-receiver/.buildResult/
tv-receiver/.tproject/

# PWA / bundler output
companion/dist/

# Downloaded library files and metadata stay local; see
# resolver/README.md
resolver/media/*
!resolver/media/.gitkeep

# companion/serve.js's saved settings (the shared Stremio addon list)
.companion-data/

# torrent-server/ run outside Docker (npm start) keeps its downloads here
torrent-server/data/
