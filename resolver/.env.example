PORT=8788
# MEDIA_DIR=/opt/tv-casting/resolver/media
MAX_HEIGHT=1080
MAX_FILESIZE=2G
MEDIA_TTL_MS=21600000
# Only set this if `yt-dlp` isn't on PATH for the service user.
# YTDLP_BIN=/usr/local/bin/yt-dlp
# How long the rendered-page fallback (genericExtract.js) waits for a
# page to finish loading before giving up.
GENERIC_EXTRACT_TIMEOUT_MS=20000
# Set to 0 to disable the rendered-page fallback entirely (e.g. if
# Playwright/Chromium isn't installed on this host).
ENABLE_GENERIC_FALLBACK=1
# Saved videos and torrents remain until deleted from Library. Monitor disk space.
# How long a torrent may take to start sending data. See README.md,
# "Torrents".
TORRENT_START_TIMEOUT_MS=180000
# Films bigger than 1080p are converted down for the TV as they're saved,
# on an NVIDIA GPU if there is one (auto | nvenc | x264), and the original
# is kept too (0 = keep only the TV's 1080p copy). See README.md.
TORRENT_MAX_HEIGHT=1080
TORRENT_ENCODER=auto
TORRENT_KEEP_ORIGINAL=1
